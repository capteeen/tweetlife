// The presence server (party/world.ts) on your own Cloudflare account, through PartyServer.
// Deployed by .github/workflows/party-deploy.yml; locally: cd presence && npx wrangler dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweetlife-presence",
  "account_id": "3d2a41fdccf500f61e2bd2d056b8dfee",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "World", "class_name": "World" }]
  },
  // SQLite-backed Durable Objects are the kind the free plan allows
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true }
}
