// TweetLife data model.
// Everything the app renders is read from here. /lib/x is the only writer that talks to X.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngestState {
  queued
  building
  live
  failed
}

enum Access {
  followers
  public
  invite
}

enum StructureKind {
  pillar // standalone text post
  spire // segment of a thread (same conversation_id, authored by owner)
  monolith // post with photo — framed, shows the real image
  obelisk // post with video
  outbuilding // reply to someone else
  lantern // repost — light, no mass
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  dead // exhausted retries; shown in the dead-letter list with a manual retry
}

enum RunKind {
  first_build
  incremental
  metrics_refresh
}

/// A signed-in X account. Tokens are AES-256-GCM encrypted with TOKEN_ENCRYPTION_KEY.
model User {
  id              String    @id // X user id
  handle          String    @unique
  name            String
  avatarUrl       String?
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime
  scopes          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?

  world    World?
  marks    Mark[]
  lanterns Lantern[]
  apiCalls ApiCall[]
  player   Player?
}

model World {
  id               String      @id @default(cuid())
  handle           String      @unique
  xUserId          String      @unique
  owner            User        @relation(fields: [xUserId], references: [id], onDelete: Cascade)
  /// The X account's created_at — drives sky phase.
  accountCreatedAt DateTime
  createdAt        DateTime    @default(now())
  biome            String      @default("meadow") // meadow | dune | tundra | reef | ember
  access           Access      @default(followers)
  listedOnExplore  Boolean     @default(false)
  landmarkPostId   String? // manual pin; null = highest engagement post of all time
  followersCount   Int         @default(0)
  followingCount   Int         @default(0)
  postCount        Int         @default(0) // public_metrics.tweet_count from X — real, may exceed what we could fetch
  lastSyncAt       DateTime?
  nextSyncAt       DateTime?
  ingestState      IngestState @default(queued)
  ingestError      String?
  /// Newest post id we have — since_id for incremental sync.
  newestPostId     String?
  /// Oldest post id we have — pagination_token resumes from here on first build if interrupted.
  oldestPostId     String?
  showReplies      Boolean     @default(true)
  showMetrics      Boolean     @default(true)
  chatEnabled      Boolean     @default(false)
  /// Owner-laid paths: JSON array of [{x,z}] polylines in world units.
  paths            Json        @default("[]")
  updatedAt        DateTime    @updatedAt

  structures Structure[]
  marks      Mark[]
  ingestRuns IngestRun[]
  lanterns   Lantern[]
  sessions   VisitorSession[]
  timelapses TimelapseJob[]

  @@index([listedOnExplore, access])
}

model Structure {
  id             String        @id @default(cuid())
  worldId        String
  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  postId         String
  kind           StructureKind
  conversationId String?
  /// For replies: the post id replied to. For reposts: the reposted post id.
  referencedId   String?
  text           String
  mediaUrl       String?
  mediaKind      String? // photo | video | animated_gif
  likes          Int? // null = metrics missing from X; structure renders at minimum scale
  reposts        Int?
  replies        Int?
  impressions    Int?
  postedAt       DateTime
  hidden         Boolean       @default(false)
  lanternsLit    Int           @default(0)
  metricsAt      DateTime      @default(now())
  createdAt      DateTime      @default(now())

  lanterns Lantern[]

  @@unique([worldId, postId])
  @@index([worldId, postedAt])
  @@index([worldId, conversationId])
}

/// A guestbook stone.
model Mark {
  id       String   @id @default(cuid())
  worldId  String
  world    World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  byUserId String
  by       User     @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  byHandle String
  text     String
  x        Float
  z        Float
  /// true when the owner follows the visitor back (one cached relationship check).
  bright   Boolean  @default(false)
  at       DateTime @default(now())

  @@unique([worldId, byUserId])
  @@index([worldId, at])
}

/// An on-world like. One per visitor per structure.
model Lantern {
  id          String    @id @default(cuid())
  worldId     String
  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  byUserId    String
  by          User      @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  at          DateTime  @default(now())

  @@unique([structureId, byUserId])
  @@index([worldId, at])
}

model VisitorSession {
  id            String    @id @default(cuid())
  worldId       String
  world         World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  visitorId     String?
  visitorHandle String
  x             Float     @default(0)
  z             Float     @default(0)
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?

  @@index([worldId, joinedAt])
}

model IngestRun {
  id           String    @id @default(cuid())
  worldId      String
  world        World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  kind         RunKind
  status       RunStatus @default(queued)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  pagesFetched Int       @default(0)
  postsWritten Int       @default(0)
  calls        Int       @default(0)
  attempts     Int       @default(0)
  error        String?
  jobId        String?
  /// Inline (worker-less) mode: earliest time the next attempt may run; set on retry backoff.
  notBefore    DateTime?
  /// Inline mode: last time a step touched this run; a stale heartbeat on a `running` row means the function died.
  heartbeatAt  DateTime?

  @@index([worldId, startedAt])
  @@index([status, notBefore])
}

/// One row per outbound request to api.x.com. This is the budget ledger — monthly quota is SUM(1) here.
model ApiCall {
  id                 BigInt    @id @default(autoincrement())
  at                 DateTime  @default(now())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint           String
  status             Int
  rateLimitRemaining Int?
  rateLimitReset     DateTime?
  durationMs         Int

  @@index([at])
  @@index([endpoint, at])
}

model TimelapseJob {
  id         String    @id @default(cuid())
  worldId    String
  world      World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  status     RunStatus @default(queued)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  filePath   String?
  error      String?

  @@index([worldId, startedAt])
}

/// Operator-authored incident notes shown on /status.
model Incident {
  id         String    @id @default(cuid())
  title      String
  body       String
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ---------------------------------------------------------------------------------------------
// Life layer: an in-world economy and social stats. "Bags" are in-world points, never money.
// Token prices in the Trenches are real (DexScreener); positions are paper positions in bags.
// ---------------------------------------------------------------------------------------------

model Player {
  id          String   @id // = User.id
  user        User     @relation(fields: [id], references: [id], onDelete: Cascade)
  bags        Int      @default(10000)
  vibes       Int      @default(70) // fun
  clout       Int      @default(50) // social
  gas         Int      @default(80) // energy
  status      String   @default("Just arrived")
  /// When `status` stops being true (the activity, nap or furniture action ends). Null or past = idle.
  statusUntil DateTime?
  /// The look picked in the avatar creator (lib/life/look.ts). Null = seeded from the handle.
  look        Json?
  /// True for players created after the avatar creator shipped, until they pick a look.
  lookPending Boolean  @default(false)
  /// Country id from lib/world/countries.ts, picked at sign-up. Null = not asked yet (shown once, Solana on skip).
  nationality String?
  /// The country the player is in right now (lib/world/countries.ts id). Null = at home. Set by flights.
  location    String?
  /// The guided first day (lib/life/firstDay.ts): "active" for new players, then "done" or "skipped".
  /// Null = never offered (players from before it existed); they can start it from Settings.
  firstDay    String?
  lastTickAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet     Wallet?
  walletTxs  WalletTx[]
  txs        BagTx[]
  questDays  QuestDay[]
  sent       Interaction[] @relation("sent")
  received   Interaction[] @relation("received")
  assets     Asset[]
  paperCoins PaperCoin[]
  bonds      Bond[]          @relation("bonds")
  bondedTo   Bond[]          @relation("bondedTo")
  loveSent   SocialRequest[] @relation("loveSent")
  loveGot    SocialRequest[] @relation("loveGot")
  firstDaySteps FirstDayStep[]
  suggestions Suggestion[]
  backed      SuggestionBacker[]
}

model BagTx {
  id       String   @id @default(cuid())
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind     String // buy | sell | tip_in | tip_out | quest | welcome
  amount   Int // signed
  note     String
  at       DateTime @default(now())

  @@index([playerId, at])
}

model Interaction {
  id         String   @id @default(cuid())
  worldId    String?
  fromUserId String
  from       Player   @relation("sent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         Player   @relation("received", fields: [toUserId], references: [id], onDelete: Cascade)
  kind       String
  at         DateTime @default(now())

  @@index([fromUserId, at])
  @@index([toUserId, at])
}

/// Daily quest claims. Progress is computed from real activity; this stores what was claimed.
model QuestDay {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day      String // YYYY-MM-DD (UTC)
  claimed  Json   @default("[]")

  @@unique([playerId, day])
}

/// Something bought in the Market (a vehicle, for now). Counted in net worth at purchase price.
model Asset {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  itemId     String
  paid       Int
  equipped   Boolean  @default(false)
  /// furniture only: the room slot it belongs to (null for vehicles)
  slot       String?
  /// furniture only: owned but not in the room (replaced by a better piece)
  stored     Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@unique([playerId, itemId])
}

/// The account's real Solana wallet. secretKeyEnc is AES-256-GCM under TOKEN_ENCRYPTION_KEY and is only ever
/// decrypted to sign a transaction the owner asked for, or to export to the owner.
model Wallet {
  id           String    @id // = Player.id
  player       Player    @relation(fields: [id], references: [id], onDelete: Cascade)
  publicKey    String    @unique
  secretKeyEnc String
  cluster      String
  exportedAt   DateTime?
  createdAt    DateTime  @default(now())
}

/// Our record of on-chain activity initiated here (the chain is the source of truth).
model WalletTx {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind      String // swap_buy | swap_sell | send | airdrop
  lamports  BigInt // SOL moved, signed (negative = out); 0 when unknown
  mint      String?
  signature String?  @unique
  note      String
  at        DateTime @default(now())

  @@index([playerId, at])
}

/// A memecoin bought with bags at the Coin Shop: a paper position priced from the live DexScreener feed.
/// No chain, no wallet; selling turns it back into bags at the live price.
model PaperCoin {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  chain     String
  mint      String
  symbol    String
  icon      String?
  units     Float
  /// bags paid in, net of anything sold (for profit and loss)
  costBags  Int
  updatedAt DateTime @updatedAt

  @@unique([playerId, mint])
}

/// One side of a relationship: you and another player (partnerId) or you and an AI resident (residentId).
/// Player-to-player bonds are written in pairs, one row per side, in one transaction. Rules in lib/life/love.ts.
model Bond {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation("bonds", fields: [playerId], references: [id], onDelete: Cascade)
  partnerId   String?
  partner     Player?   @relation("bondedTo", fields: [partnerId], references: [id], onDelete: Cascade)
  residentId  String?
  /// talking (visited, or chatted with a resident) | dating (counts against the cap of six) | ended
  status      String    @default("talking")
  /// AI residents only: how well you get on, 0..100
  affinity    Int       @default(0)
  since       DateTime  @default(now())
  datingSince DateTime?
  endedAt     DateTime?
  lastDateAt  DateTime?
  dates       Int       @default(0)

  @@unique([playerId, partnerId])
  @@unique([playerId, residentId])
  @@index([partnerId])
  @@index([playerId, status])
}

/// A request to another player (answered later, in their phone) or to an AI resident (answered on the spot):
/// invite home, ask to come over, ask out, or go on a date with a partner.
model SocialRequest {
  id          String    @id @default(cuid())
  fromId      String
  from        Player    @relation("loveSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String?
  to          Player?   @relation("loveGot", fields: [toId], references: [id], onDelete: Cascade)
  residentId  String?
  /// invite | visit | date | outing
  kind        String
  /// outing only: which date (lib/life/love.ts DATES)
  detail      String?
  /// pending | accepted | declined | cancelled
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  /// an accepted invite or visit: the guest may be in the host's house until then
  passUntil   DateTime?

  @@index([toId, status])
  @@index([fromId, status])
  @@index([fromId, toId, kind])
}

/// A step of the guided first day the player finished. One row per step, so its reward is paid exactly once.
model FirstDayStep {
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  step     String // passport | ride | furniture | shift | coin | finish
  reward   Int
  at       DateTime @default(now())

  @@id([playerId, step])
}

/// A suggestion a citizen filed with their president at the government house (lib/life/suggestions.ts).
/// Kept for good: the president answers it, other citizens back it, and the most-backed ones reach the
/// cabinet's agenda and the president's own talking points.
model Suggestion {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Country id (lib/world/countries.ts): whose president it was filed with
  country   String
  topic     String
  text      String
  /// review (answered, under review) | agenda (enough citizens backed it to go on the cabinet's agenda)
  status    String   @default("review")
  /// The president's answer
  reply     String?
  backers   Int      @default(0)
  createdAt DateTime @default(now())

  backedBy SuggestionBacker[]

  @@index([country, status, backers])
  @@index([playerId, createdAt])
}

model SuggestionBacker {
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  at           DateTime   @default(now())

  @@id([suggestionId, playerId])
}
