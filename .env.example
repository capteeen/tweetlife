# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random bytes, base64. Used to sign session cookies.  `openssl rand -base64 48`
SESSION_SECRET=
# 32 bytes, base64. Used to AES-256-GCM encrypt X refresh/access tokens at rest. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# ---- X (developer.x.com, OAuth 2.0, type "Web App", callback = $NEXT_PUBLIC_APP_URL/api/auth/x/callback) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
# Which API tier the project is on. Drives the /status page math and README budget numbers.
# free | basic | pro
X_API_TIER=basic
# Hard monthly budget of X API calls across the whole deployment. 80% -> admin alert, 100% -> no new world builds.
X_MONTHLY_CALL_BUDGET=10000
# Global token bucket: sustained calls/sec across every token, and burst size.
X_GLOBAL_RATE_PER_SEC=2
X_GLOBAL_BURST=5
# Per-user token bucket.
X_USER_RATE_PER_SEC=0.5
X_USER_BURST=3
# Max tweets fetched per world on first build (the API caps timeline pagination at 3200).
X_FIRST_BUILD_MAX_POSTS=3200

# ---- Storage ----
DATABASE_URL=postgresql://tweetlife:tweetlife@localhost:5432/tweetlife
REDIS_URL=redis://localhost:6379

# ---- Presence (PartyKit). Leave empty to run worlds without live visitors/chat. ----
NEXT_PUBLIC_PARTYKIT_HOST=
# Shared HMAC secret between the app and PartyKit (set the same value with `npx partykit env add PRESENCE_SECRET`).
PRESENCE_SECRET=

# ---- Operator ----
# The X handle (without @) whose public world is embedded on the landing page. Must be a real signed-in world set to public.
OPERATOR_HANDLE=
# Comma-separated X handles allowed to see admin alerts on /status.
ADMIN_HANDLES=
# Where timelapse MP4s are written (served from /api/timelapse/[id]).
RENDER_DIR=./renders
